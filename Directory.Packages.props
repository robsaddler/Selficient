<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Versions checked against nuget.org on 29 Oct 2026. Bump deliberately; Dependabot proposes. -->

  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- The self-hosted basemap (M5): Dapper over a read-only SQLite MBTiles archive. -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- The platform database (M19): SQL Server through Dapper, migrations as embedded scripts. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.14" />
    <!-- Transitive pin: SqlClient 7.1 still references the 9.0 Pkcs package with two advisories against it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
    <!-- Telemetry (M19): OpenTelemetry for traces and metrics, Serilog carrying the logs to the same collector. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- Photos and AI (M8): SkiaSharp (MIT) re-encodes every upload; the official Anthropic SDK calls Claude. -->
    <PackageVersion Include="Anthropic" Version="13.3.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup Label="Later milestones (declared so versions are pinned when first referenced)">
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageVersion Include="WireMock.Net" Version="2.21.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="NBomber" Version="6.7.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageVersion Include="NBomber.Http" Version="6.2.1" />
  </ItemGroup>

</Project>
