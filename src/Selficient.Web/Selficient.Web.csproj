<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Selficient.Web</RootNamespace>
    <UserSecretsId>selficient-web</UserSecretsId>
    <!-- Razor pages are compiled into the assembly; no runtime compilation, no views on disk. -->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <!-- Trim and single-file analyzers do not apply to a Razor Pages host. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <!-- CA1515 wants public types internal in executables; Razor PageModels and tag helpers must be public. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Selficient.Application/Selficient.Application.csproj" />
    <ProjectReference Include="../Selficient.Infrastructure/Selficient.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
