<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS/Plesk: the WebDAV module intercepts DELETE and PUT verbs and answers 403 before the request
  reaches ASP.NET Core (SiteWise lesson). Removing it here keeps every verb reachable. The SDK's
  publish transform merges the aspNetCore handler and module configuration into this file.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="10485760" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
