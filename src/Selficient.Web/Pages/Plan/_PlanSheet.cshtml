@using Selficient.Web.Formatting
@model Selficient.Web.Pages.Plan.IndexModel
@{
    var planned = Model.Planned!;
    var household = planned.Plan.Profile.Household;
    var baseline = Selficient.Domain.Readiness.Inventory.Baseline(household);
    var days = Model.Board!.DaysReady;
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var place = PlaceCopy.Place(planned.Locality)
        + (planned.Elevation is { } e ? $", {e.Metres.ToString("0", culture)} m above sea level" : "");
}

<div class="plan-layout">
<aside class="plan-aside">
<section class="hero hero--plan" aria-labelledby="plan-heading" data-plan>
  <div class="contour-band" aria-hidden="true" data-elevation="@(planned.Elevation is { } el ? el.Metres.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "0")"></div>
  <p class="eyebrow">@place</p>
  <h1 id="plan-heading">Your house could stand on its own for</h1>
  <days-ready value="@days.ToString("0.#", culture)" class="days-ready" data-people="@household.Size.Count">
    <span class="days-ready__figure">@days.ToString("0.#", culture)</span>
    <span class="days-ready__unit">@(days == 1m ? "day" : "days")</span>
  </days-ready>
  <p class="hero__lede" data-hero-scenario>In @Model.Board.Scenario.Name.ToLowerInvariant(). Tick what you already have and the figure moves. Three days is the government's ask; seven is where a storm becomes an inconvenience.</p>
</section>

@await Html.PartialAsync("_PlanMap", new Selficient.Web.Pages.Plan.HouseMapView(planned.Locality, planned.Elevation))

<section class="rely" aria-labelledby="rely-heading">
  <h2 id="rely-heading">What you rely on</h2>
  <p>A device that needs power, a medicine that must stay cold, a supply you cannot run out of. Each gets its own row on the board, with what carries it.</p>
  <ul class="rely__list" data-rely-list hidden></ul>
  <form method="post" asp-page="/Plan/Index" class="rely__form" data-rely-form>
    @foreach (var (field, value) in Model.EchoedProfile)
    {
      <input type="hidden" name="Form.@field" value="@value">
    }
    @for (var i = 0; i < Model.Form.Dependencies.Count && i < 11; i++)
    {
      var existing = Model.Form.Dependencies[i];
      if (existing.IsBlank) { continue; }
      var n = i + 1;
      <input type="hidden" name="Form.Dependencies[@n].Name" value="@existing.Name">
      <input type="hidden" name="Form.Dependencies[@n].Kind" value="@existing.Kind">
      <input type="hidden" name="Form.Dependencies[@n].Watts" value="@existing.Watts">
      <input type="hidden" name="Form.Dependencies[@n].HoursPerDay" value="@existing.HoursPerDay">
      <input type="hidden" name="Form.Dependencies[@n].DaysOfStock" value="@existing.DaysOfStock">
      <input type="hidden" name="Form.Dependencies[@n].MustStayCold" value="@(existing.MustStayCold ? "true" : "false")">
    }
    <div class="field">
      <label for="rely-name">What is it?</label>
      <input id="rely-name" name="Form.Dependencies[0].Name" class="input" maxlength="40" autocomplete="off" placeholder="Oxygen concentrator">
    </div>
    <div class="field">
      <label for="rely-kind">Which kind of thing?</label>
      <select id="rely-kind" name="Form.Dependencies[0].Kind" class="input" asp-items="Selficient.Web.Pages.Plan.PlanForm.DependencyKinds"></select>
    </div>
    <div class="rely__grid">
      <div class="field">
        <label for="rely-watts">Watts</label>
        <input id="rely-watts" name="Form.Dependencies[0].Watts" type="number" min="0" max="3000" value="0" class="input input--short" inputmode="numeric">
      </div>
      <div class="field">
        <label for="rely-hours">Hours a day</label>
        <input id="rely-hours" name="Form.Dependencies[0].HoursPerDay" type="number" min="0" max="24" value="0" class="input input--short" inputmode="numeric">
      </div>
      <div class="field">
        <label for="rely-days">Days in the house</label>
        <input id="rely-days" name="Form.Dependencies[0].DaysOfStock" type="number" min="0" max="365" value="0" class="input input--short" inputmode="numeric">
      </div>
    </div>
    <div class="field field--check">
      <input id="rely-cold" name="Form.Dependencies[0].MustStayCold" type="checkbox" value="true">
      <label for="rely-cold">It must stay cold</label>
    </div>
    <p class="field__hint">For a device, give the watts and the hours a day. For a medicine or a supply, give the days of it in the house.</p>
    <p class="field__hint" role="status" data-rely-note hidden></p>
    <p><button type="submit" class="button">Add it to the board</button></p>
  </form>
</section>
</aside>

<div class="plan-body">
<div data-board-slot>
  @await Html.PartialAsync("_Board", new Selficient.Web.Pages.Plan.BoardView(Model.Board, planned.Plan.Profile.Dwelling.HasOwnRoof))
</div>

<section class="risks" aria-labelledby="risks-heading">
  <h2 id="risks-heading">What is most likely to go wrong here</h2>
  <ol class="risk-list">
    @foreach (var risk in planned.Plan.Risks.Ranked)
    {
      <li class="risk">
        <span class="risk__kind">@RiskCopy.Title(risk.Kind)</span>
        <span class="risk__rating data">@RiskCopy.Rating(risk)</span>
        <p class="risk__why">@risk.Rationale</p>
      </li>
    }
  </ol>
</section>

<section class="plan" aria-labelledby="actions-heading">
  <h2 id="actions-heading">Your plan, in order</h2>
  @foreach (var tier in planned.Plan.Tiers)
  {
    @await Html.PartialAsync("_PlanTier", new Selficient.Web.Pages.Plan.PlanTierView(tier, Model.Catalogue))
  }
  <p class="plan__total">Everything together: <span class="data">@MoneyFormat.Range(planned.Plan.Cost)</span>.</p>
  @if (planned.Plan.Profile.Dwelling.HasOwnRoof)
  {
    <p class="plan__solar">The biggest line is the roof. <a href="/plan/solar">Estimate what solar and a battery would make, save and cost for your house</a>, with the backup that keeps the lights on.</p>
  }
  <p class="plan__photos">Rather than count by hand, <a href="/plan/photos">photograph your kit cupboard, the boiler's plate and the fuse board</a> and let the photos fill the plan in.</p>
  @await Html.PartialAsync("_PlanExplain", Model)
  <p class="disclosure">Where we point to a shop, some links earn Selficient a small commission at no cost to you. Prices are what we saw on the date shown and will have moved; the sentence beside each item is why we chose it.</p>
</section>

@await Html.PartialAsync("_PlanUpkeep", new Selficient.Web.Pages.Plan.UpkeepView(planned.Plan.Profile.Dwelling))

<section class="plan-tools" aria-labelledby="tools-heading">
  <h2 id="tools-heading">Keep it safe</h2>
  <p>Your plan and your ticks are stored only in this browser. Export a copy to keep or to move to another device.</p>
  <p class="cluster">
    <button type="button" class="button" data-export-plan>Export as a file</button>
    <label class="button">Import a file<input type="file" accept="application/json" data-import-plan class="sr-only"></label>
    <a class="button button--quiet" href="/plan/start">Start again</a>
  </p>
</section>
</div>
</div>

<form class="profile-echo" data-profile-echo hidden aria-hidden="true">
  @foreach (var (field, value) in Model.EchoedProfile)
  {
    <input type="hidden" name="@field" value="@value">
  }
</form>
