@using Selficient.Web.Formatting
@model Selficient.Web.Pages.Plan.IndexModel
@{
    var planned = Model.Planned!;
    var household = planned.Plan.Profile.Household;
    var days = Model.Board!.DaysReady;
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var place = PlaceCopy.Place(planned.Locality)
        + (planned.Elevation is { } e ? $", {e.Metres.ToString("0", culture)} m above sea level" : "");
    var risks = planned.Plan.Risks.Ranked;
    var topRisks = risks.Take(3).ToList();
    var moreRisks = risks.Skip(3).ToList();
    var outcomes = Model.Board.Tiers.ToDictionary(tier => tier.Tier);
    var amounts = Selficient.Web.Pages.Plan.AmountView.For(Model.Board, household.Size.Count);
    var assumed = Model.Board.Assumed;
}

@*
  One column, in the order a household has the questions: how exposed are we; what do we do first;
  what would actually happen; what about our own needs; why these risks; where are we; how do we
  keep this going. The verdict bar keeps the first answer on the screen while the rest is read.
*@
<div class="plan-flow">

<section class="hero hero--plan night" aria-labelledby="plan-heading" data-plan data-hero>
  <div class="contour-band" aria-hidden="true" data-elevation="@(planned.Elevation is { } el ? el.Metres.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "0")"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="hero__verdict">
    <p class="eyebrow">@place</p>
    <h1 id="plan-heading">Your house could stand on its own for</h1>
    <days-ready value="@days.ToString("0.#", culture)" class="days-ready" data-people="@household.Size.Count">
      <span class="days-ready__figure">@days.ToString("0.#", culture)</span>
      <span class="days-ready__unit">@Selficient.Web.Pages.Plan.BoardCopy.Unit(days)</span>
    </days-ready>
    <p class="hero__lede" data-hero-scenario>In @Model.Board.Scenario.Name.ToLowerInvariant(). Say what you already have and the figure moves. Three days is the government's ask; seven is where a storm becomes an inconvenience.</p>
    @await Html.PartialAsync("_Strip", Selficient.Web.Pages.Plan.Strip.From(Model.Board.Current))
    @* Said once, the first time a plan is saved in this browser; keep.js shows it and remembers that it has. *@
    <p class="kept-notice" data-kept-notice role="status" hidden><svg class="mark-icon" aria-hidden="true" focusable="false"><use href="/img/marks.svg#mark-device"/></svg><span>@Selficient.Web.Pages.KeepCopy.FirstPlan</span> <button type="button" class="button button--quiet" data-kept-dismiss>Got it</button></p>
    <p class="hero__share"><button type="button" class="button button--quiet" data-share hidden>Share this figure</button> <span class="share__status" role="status" data-share-status hidden></span></p>
  </div>
  <div class="hero__scenarios">
    <h2 class="hero__scenarios-heading">What could happen here</h2>
    <p class="hero__scenarios-lede">Ranked for your address. Choose one and the page redraws for it.</p>
    @await Html.PartialAsync("_ScenarioChips", Model)
  </div>
</section>

@await Html.PartialAsync("_VerdictBar", Model)

<section class="plan" aria-labelledby="actions-heading">
  <h2 id="actions-heading">Your plan, in order</h2>
  <p class="plan__lede">Say which of these you have, which you plan to get and which are not for you. Each action says what it changes on the board, and each stretch says where it takes the house.</p>
  <div class="plan__tally">
    <h3 class="plan__tally-heading">Where your plan stands</h3>
    @await Html.PartialAsync("_Tally", Selficient.Web.Pages.Plan.TallyView.ForPlan(Model.Board))
  </div>
  <p class="undo" role="status" data-undo hidden>
    <span data-undo-said></span>
    <button type="button" class="button button--small" data-undo-button>Undo</button>
    <button type="button" class="button button--small button--quiet" data-undo-dismiss>Dismiss</button>
  </p>
  @foreach (var tier in planned.Plan.Tiers)
  {
    @await Html.PartialAsync("_PlanTier", new Selficient.Web.Pages.Plan.PlanTierView(tier, Model.Catalogue, outcomes[tier.Tier], amounts))
  }
  @* The figures the plan had to choose for itself, each open to the household's own. The script keeps the choice in this browser and the board redraws from it. *@
  <section class="assumptions" aria-labelledby="assumptions-heading">
    <h3 id="assumptions-heading">What the plan assumes</h3>
    <p class="assumptions__lede">Where nothing published settles a figure, the plan uses its own. Change it to yours and everything that rests on it follows.</p>
    <div class="assumptions__item">
      <label for="assume-cash">@Selficient.Web.Pages.Plan.AmountCopy.CashRateLabel</label>
      <div class="assumptions__row">
        <span aria-hidden="true">£</span>
        <input id="assume-cash" class="input input--short" type="number" inputmode="numeric" min="@Selficient.Domain.Resilience.Assumptions.MinCashPoundsPerPersonPerDay" max="@Selficient.Domain.Resilience.Assumptions.MaxCashPoundsPerPersonPerDay" step="1" autocomplete="off" value="@assumed.CashPoundsPerPersonPerDay" data-assume-cash data-assume-default="@Selficient.Domain.Resilience.Assumptions.Default.CashPoundsPerPersonPerDay" aria-describedby="assume-cash-says">
        <span>pounds a person a day</span>
        <button type="button" class="tally__button" data-assume-reset>@Selficient.Web.Pages.Plan.AmountCopy.CashRateReset</button>
      </div>
      <p class="field__hint" id="assume-cash-says" data-assume-cash-says>@Selficient.Web.Pages.Plan.AmountCopy.CashRateSays(assumed, household.Size.Count)</p>
    </div>
  </section>
  <p class="plan__total">Everything together: <span class="data">@MoneyFormat.Range(planned.Plan.Cost)</span>.</p>
  @if (planned.Plan.Profile.Dwelling.HasOwnRoof)
  {
    <p class="plan__solar">The biggest line is the roof. <a href="/plan/solar">Estimate what solar and a battery would make, save and cost for your house</a>, with the backup that keeps the lights on.</p>
  }
  <p class="plan__photos">Rather than count by hand, <a href="/plan/photos">photograph your kit cupboard, the boiler's plate and the fuse board</a> and let the photos fill the plan in.</p>
  @await Html.PartialAsync("_PlanExplain", Model)
  <p class="disclosure">Where we point to a shop, some links earn Selficient a small commission at no cost to you. Prices are what we saw on the date shown and will have moved; the sentence beside each item is why we chose it.</p>
</section>

<div data-board-slot>
  @await Html.PartialAsync("_Board", new Selficient.Web.Pages.Plan.BoardView(Model.Board, planned.Plan.Profile.Dwelling.HasOwnRoof, household.Size.Count))
</div>

<section class="rely" aria-labelledby="rely-heading">
  <h2 id="rely-heading">What you rely on</h2>
  <p>A device that needs power, a medicine that must stay cold, a supply you cannot run out of. Each gets its own row on the board above, with what carries it.</p>
  <ul class="rely__list" data-rely-list hidden></ul>
  <form method="post" asp-page="/Plan/Index" class="rely__form" data-rely-form>
    @foreach (var (field, value) in Model.EchoedProfile)
    {
      <input type="hidden" name="Form.@field" value="@value">
    }
    @for (var i = 0; i < Model.Form.Dependencies.Count && i < 11; i++)
    {
      var existing = Model.Form.Dependencies[i];
      if (existing.IsBlank) { continue; }
      var n = i + 1;
      <input type="hidden" name="Form.Dependencies[@n].Name" value="@existing.Name">
      <input type="hidden" name="Form.Dependencies[@n].Kind" value="@existing.Kind">
      <input type="hidden" name="Form.Dependencies[@n].Watts" value="@existing.Watts">
      <input type="hidden" name="Form.Dependencies[@n].HoursPerDay" value="@existing.HoursPerDay">
      <input type="hidden" name="Form.Dependencies[@n].DaysOfStock" value="@existing.DaysOfStock">
      <input type="hidden" name="Form.Dependencies[@n].MustStayCold" value="@(existing.MustStayCold ? "true" : "false")">
    }
    <div class="rely__fields">
      <div class="field">
        <label for="rely-name">What is it?</label>
        <input id="rely-name" name="Form.Dependencies[0].Name" class="input" maxlength="40" autocomplete="off" placeholder="Oxygen concentrator">
      </div>
      <div class="field">
        <label for="rely-kind">Which kind of thing?</label>
        <select id="rely-kind" name="Form.Dependencies[0].Kind" class="input" asp-items="Selficient.Web.Pages.Plan.PlanForm.DependencyKinds"></select>
      </div>
    </div>
    <div class="rely__grid">
      <div class="field">
        <label for="rely-watts">Watts</label>
        <input id="rely-watts" name="Form.Dependencies[0].Watts" type="number" min="0" max="3000" value="0" class="input input--short" inputmode="numeric">
      </div>
      <div class="field">
        <label for="rely-hours">Hours a day</label>
        <input id="rely-hours" name="Form.Dependencies[0].HoursPerDay" type="number" min="0" max="24" value="0" class="input input--short" inputmode="numeric">
      </div>
      <div class="field">
        <label for="rely-days">Days in the house</label>
        <input id="rely-days" name="Form.Dependencies[0].DaysOfStock" type="number" min="0" max="365" value="0" class="input input--short" inputmode="numeric">
      </div>
    </div>
    <div class="field field--check">
      <input id="rely-cold" name="Form.Dependencies[0].MustStayCold" type="checkbox" value="true">
      <label for="rely-cold">It must stay cold</label>
    </div>
    <p class="field__hint">For a device, give the watts and the hours a day. For a medicine or a supply, give the days of it in the house.</p>
    <p class="field__hint" role="status" data-rely-note hidden></p>
    <p><button type="submit" class="button">Add it to the board</button></p>
  </form>
</section>

<section class="risks" aria-labelledby="risks-heading">
  <h2 id="risks-heading">What is most likely to go wrong here</h2>
  <p class="risks__lede">The three that decide the order of your plan, and the rest for the record.</p>
  <ol class="risk-list">
    @foreach (var risk in topRisks)
    {
      <li class="risk">
        <span class="risk__kind">@RiskCopy.Title(risk.Kind)</span>
        <span class="risk__rating data">@RiskCopy.Rating(risk)</span>
        <p class="risk__why">@risk.Rationale</p>
      </li>
    }
  </ol>
  @if (moreRisks.Count > 0)
  {
    <details class="risks__more">
      <summary>@RiskCopy.More(moreRisks.Count)</summary>
      <ol class="risk-list" start="@(topRisks.Count + 1)">
        @foreach (var risk in moreRisks)
        {
          <li class="risk">
            <span class="risk__kind">@RiskCopy.Title(risk.Kind)</span>
            <span class="risk__rating data">@RiskCopy.Rating(risk)</span>
            <p class="risk__why">@risk.Rationale</p>
          </li>
        }
      </ol>
    </details>
  }
</section>

@await Html.PartialAsync("_PlanMap", new Selficient.Web.Pages.Plan.HouseMapView(planned.Locality, planned.Elevation))

@await Html.PartialAsync("_PlanUpkeep", new Selficient.Web.Pages.Plan.UpkeepView(planned.Plan.Profile.Dwelling))

<section class="plan-tools" aria-labelledby="tools-heading">
  <h2 id="tools-heading">Keep it safe</h2>
  <p>Your plan and what you said about each action are stored only in this browser. Export a copy to keep or to move to another device.</p>
  <p class="cluster">
    <button type="button" class="button" data-export-plan>Export as a file</button>
    <label class="button">Import a file<input type="file" accept="application/json" data-import-plan class="sr-only"></label>
    <a class="button button--quiet" href="/plan/start">Start again</a>
  </p>
  <details class="clear" data-clear>
    <summary>Clear my plan from this browser</summary>
    <p>This removes your answers, what you said about each action, the pin on the map and what you rely on from this browser. Export a file first if you want them back. Your theme choice stays.</p>
    <p><button type="button" class="button button--danger" data-clear-plan>Clear it</button></p>
  </details>
</section>
</div>

<form class="profile-echo" data-profile-echo hidden aria-hidden="true">
  @foreach (var (field, value) in Model.EchoedProfile)
  {
    <input type="hidden" name="@field" value="@value">
  }
</form>
