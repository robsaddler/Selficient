@using Selficient.Application.Resilience
@using Selficient.Domain.Resilience
@model Selficient.Web.Pages.Plan.BoardView
@{
    var set = Model.Set;
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var rungs = new[] { Rung.Normal, Rung.House, Rung.Function, Rung.Survive };
    // The needs this sheet draws differently from today, each with its row as it stands today: those are drawn twice, one line above the other.
    var pairs = Selficient.Web.Pages.Plan.BoardCopy.Pairs(set);
    var shifts = set.Compared.ToDictionary(shift => shift.Key, shift => shift.Shift);
}

@functions {
    // One line of cells for a need. In a pair each cell says which line it is on before its own sentence.
    private void Cells(BoardRow row, string? line)
    {
        foreach (var cell in row.Cells)
        {
            <span class="cell cell--@cell.State.ToString().ToLowerInvariant()" role="img" aria-label="@(line is null ? Selficient.Web.Pages.Plan.BoardCopy.Cell(row, cell) : Selficient.Web.Pages.Plan.BoardCopy.Cell(row, cell, line))" data-when="@BoardComposer.HorizonWords(cell.Horizon)">
              @if (cell.State != CellState.Held && cell.HeldDays > 0)
              {
                <span class="cell__days data">@cell.HeldDays</span>
              }
            </span>
        }
    }
}

<section class="board" aria-labelledby="board-heading" data-board data-days-ready="@set.DaysReady.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" data-scenario="@set.Scenario.Id" data-scenario-name="@set.Scenario.Name" data-source="@set.SourceId" data-season="@set.Season">
  <p class="eyebrow">The board</p>
  <h2 id="board-heading">@set.Scenario.Name: what holds, what goes, and when</h2>
  <p class="board__sentence">@set.Scenario.Sentence</p>

  @* The scenario chips live in the hero; the figures on them follow the board, so the fragment carries them here for the script. *@
  <ul hidden data-board-cards>
    @foreach (var card in set.Cards)
    {
      <li data-card-id="@card.Id" data-days="@card.DaysReady.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" data-selected="@(card.Selected ? "true" : "false")">@Selficient.Web.Pages.Plan.BoardCopy.DaysReady(card.DaysReady)</li>
    }
  </ul>
  @* Where each tier takes the house, for the tier headers on the plan. *@
  <ul hidden data-board-tiers>
    @foreach (var tier in set.Tiers)
    {
      <li data-tier="@tier.Tier" data-days="@tier.DaysReady.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)">@Selficient.Web.Pages.Plan.BoardCopy.TierOutcome(tier.DaysReady, tier.Excludes)</li>
    }
  </ul>
  @* How far the household's own figures take it towards each action it counted; the script puts each under its action. *@
  <ul hidden data-board-progress>
    @foreach (var counted in set.Progress)
    {
      <li data-progress-action="@counted.Counted.ActionId">@Selficient.Web.Pages.Plan.AmountCopy.Progress(counted)</li>
    }
  </ul>
  @* What each counted action asks for under the assumptions in force, and what the cash rate comes to; the script copies these onto the boxes. *@
  <ul hidden data-board-targets data-cash-says="@Selficient.Web.Pages.Plan.AmountCopy.CashRateSays(set.Assumed, Model.People)">
    @foreach (var target in set.Targets)
    {
      <li data-target-action="@target.ActionId" data-target="@target.Target.ToString("0", System.Globalization.CultureInfo.InvariantCulture)">@Selficient.Web.Pages.Plan.AmountCopy.Suggests(target.StockId, target.Target, set.Assumed)</li>
    }
  </ul>
  @* The counts for the whole plan and for each stretch; the script copies each onto the tally of the same scope. *@
  <div hidden data-board-tallies>
    @await Html.PartialAsync("_Tally", Selficient.Web.Pages.Plan.TallyView.ForPlan(set))
    @foreach (var tier in set.Tiers)
    {
      @await Html.PartialAsync("_Tally", Selficient.Web.Pages.Plan.TallyView.ForTier(tier))
    }
  </div>

  <div class="board__switches">
    <fieldset class="seg" data-board-sources>
      <legend>If we had</legend>
      @foreach (var source in set.Sources)
      {
        var id = $"source-{source.Id}";
        <input type="radio" name="board-source" id="@id" value="@source.Id" class="seg__input" checked="@(source.Id == set.SourceId)">
        <label for="@id" class="seg__pill" title="@source.Sentence"><svg class="mark-icon" aria-hidden="true" focusable="false"><use href="@(Selficient.Web.Pages.Plan.Marks.Sprite)#@Selficient.Web.Pages.Plan.Marks.ForSource(source.Id)"/></svg>@source.Name</label>
      }
    </fieldset>
    <fieldset class="seg" data-board-seasons>
      <legend>Season</legend>
      <input type="radio" name="board-season" id="season-winter" value="Winter" class="seg__input" checked="@(set.Season == Season.Winter)">
      <label for="season-winter" class="seg__pill">Winter</label>
      <input type="radio" name="board-season" id="season-summer" value="Summer" class="seg__input" checked="@(set.Season == Season.Summer)">
      <label for="season-summer" class="seg__pill">Summer</label>
    </fieldset>
  </div>

  @if (set.SourceId != BoardSet.HouseSource)
  {
    @* Another position is on the board: a sentence says what it adds up to, and every need it changes is drawn twice below, as it stands today and with this. The switch narrows the board to those needs; the script remembers it through a redraw. *@
    <div class="board__compare">
      <p class="board__comparison" data-board-comparison>@Selficient.Web.Pages.Plan.BoardCopy.Comparison(set)</p>
      @if (pairs.Count > 0)
      {
        <p class="board__pairs-note">Each need that changes is drawn twice: as it stands today, and with this.</p>
        <label class="board__compare-switch"><input type="checkbox" data-board-only-changes> <span>Show only what changes</span></label>
      }
    </div>
  }
  @{
    var board = set.Sheet;
  }
  @* One sheet: the chosen source in the chosen season. A switch posts for another, which costs the server a few milliseconds and the page nothing it does not show. *@
  <div class="board__sheet" data-source="@set.SourceId" data-season="@set.Season" data-paired="@Selficient.Web.Pages.Plan.TallyCopy.Flag(pairs.Count > 0)">
      @* Each rung is its own band with its name, what it is for and how it stands, and its own column labels, so four groups read as four and not as one long table. *@
      @foreach (var rung in rungs)
      {
        var rows = board.Rows.Where(row => row.Rung == rung && row.Needed).ToList();
        if (rows.Count == 0)
        {
          continue;
        }
        <section class="board__rung" aria-labelledby="rung-@rung">
          <header class="board__rung-head">
            <svg class="board__rung-mark" aria-hidden="true" focusable="false"><use href="@(Selficient.Web.Pages.Plan.Marks.Sprite)#@Selficient.Web.Pages.Plan.BoardCopy.RungMark(rung)"/></svg>
            <h3 class="board__rung-name" id="rung-@rung">@Selficient.Web.Pages.Plan.BoardCopy.RungName(rung)</h3>
            <p class="board__rung-what">@Selficient.Web.Pages.Plan.BoardCopy.RungWhat(rung)</p>
            <p class="board__rung-summary data">@Selficient.Web.Pages.Plan.BoardCopy.RungSummary(rows)</p>
          </header>
          <div class="board__head" aria-hidden="true">
            <span class="board__corner"></span>
            @foreach (var horizon in set.Scenario.Horizons)
            {
              <span class="board__col">@BoardComposer.HorizonWords(horizon)</span>
            }
          </div>
          @foreach (var row in rows)
          {
            <details class="board__row" data-turned="@Selficient.Web.Pages.Plan.TallyCopy.Flag(shifts.ContainsKey(row.Key))" data-paired="@Selficient.Web.Pages.Plan.TallyCopy.Flag(pairs.ContainsKey(row.Key))">
              <summary class="board__summary">
                <span class="board__need"><svg class="mark-icon" aria-hidden="true" focusable="false"><use href="@(Selficient.Web.Pages.Plan.Marks.Sprite)#@Selficient.Web.Pages.Plan.Marks.ForRow(row.Key)"/></svg>@row.Name
                  @if (shifts.TryGetValue(row.Key, out var shift))
                  {
                    <span class="board__delta">@Selficient.Web.Pages.Plan.BoardCopy.Delta(shift)</span>
                  }
                </span>
                @if (pairs.TryGetValue(row.Key, out var was))
                {
                  <span class="board__when" data-line="today">@Selficient.Web.Pages.Plan.BoardCopy.Today</span>
                  Cells(was, Selficient.Web.Pages.Plan.BoardCopy.Today);
                  <span class="board__when" data-line="with">@Selficient.Web.Pages.Plan.BoardCopy.WithThis</span>
                  Cells(row, Selficient.Web.Pages.Plan.BoardCopy.WithThis);
                }
                else
                {
                  Cells(row, null);
                }
              </summary>
              <p class="board__why">@Selficient.Web.Pages.Plan.BoardCopy.Row(row)</p>
            </details>
          }
        </section>
      }
      <p class="board__headline">In @set.Scenario.Name.ToLowerInvariant(), with @(set.Sources.First(s => s.Id == set.SourceId).Name.ToLowerInvariant()), this house stands on its own for <strong class="data">@Selficient.Web.Pages.Plan.BoardCopy.DaysReady(board.DaysReady)</strong> in @set.Season.ToString().ToLowerInvariant().</p>
    </div>

  <p class="board__key">
    <span><i class="cell cell--held" aria-hidden="true"></i>@Selficient.Web.Pages.Plan.BoardCopy.State(CellState.Held)</span>
    <span><i class="cell cell--reduced" aria-hidden="true"></i>@Selficient.Web.Pages.Plan.BoardCopy.State(CellState.Reduced)</span>
    <span><i class="cell cell--rationed" aria-hidden="true"></i>@Selficient.Web.Pages.Plan.BoardCopy.State(CellState.Rationed)</span>
    <span><i class="cell cell--lost" aria-hidden="true"></i>@Selficient.Web.Pages.Plan.BoardCopy.State(CellState.Lost)</span>
    <span>A number on a cell is how many days it held before it changed. Tap a row for the reason.</span>
  </p>
  @if (!Model.HasOwnRoof)
  {
    <p class="board__note">A home battery needs a roof of your own, so it is not among the sources for a flat.</p>
  }

  @* The strip under the figure follows the board for what the house has; the script copies these onto it. *@
  <ul hidden data-board-strip>
    @foreach (var bar in Selficient.Web.Pages.Plan.Strip.From(set.Current))
    {
      <li data-strip-need="@bar.Key" data-days="@bar.Figure" data-reduced="@(bar.Reduced ? "true" : "false")" data-throughout="@(bar.HeldThroughout ? "true" : "false")">@bar.Sentence</li>
    }
  </ul>

  @* What each untaken action would turn, for the plan's actions to show; the script moves these under the actions. *@
  <ul hidden data-board-turns>
    @foreach (var turn in set.Turns)
    {
      <li data-turns-action="@turn.Action.Value">@Selficient.Web.Pages.Plan.BoardCopy.Turns(turn.Shifts)</li>
    }
  </ul>
</section>
