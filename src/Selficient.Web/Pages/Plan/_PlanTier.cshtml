@using Selficient.Web.Formatting
@model Selficient.Web.Pages.Plan.PlanTierView
@{
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var tier = Model.Tier;
    var index = (int)tier.Tier + 1;
    var gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
}

@* The first two stretches open; the later ones are for later, and fold away so a phone is not a
   thirty-action scroll. Every action stays in the page for the script and for search. *@
<details class="sheet" data-tier="@tier.Tier" open="@(index <= 2)">
  <summary class="sheet__header">
    <span class="sheet__index" aria-hidden="true">@index</span>
    <h3>@tier.Title</h3>
    <span class="data">@MoneyFormat.Range(tier.Cost)</span>
    <span class="sheet__chevron" aria-hidden="true"></span>
    <span class="sheet__outcome" data-tier-outcome="@tier.Tier">@Selficient.Web.Pages.Plan.BoardCopy.TierOutcome(Model.Outcome, Model.Reached.Excludes)</span>
  </summary>
  @if (tier.Actions.Count == 0)
  {
    <p class="sheet__empty">Nothing extra for your home in this stretch.</p>
  }
  else
  {
    <progress class="tier-progress" value="0" max="@tier.Actions.Count" data-tier-progress aria-label="Actions you have in this stretch">0 of @tier.Actions.Count</progress>
    @await Html.PartialAsync("_Tally", Selficient.Web.Pages.Plan.TallyView.ForTier(Model.Reached))
    <ul class="actions">
      @foreach (var action in tier.Actions)
      {
        var picks = Model.Picks[action.Id];
        var id = action.Id.Value;
        @* One choice an action: have it, plan to, or not for me. Each is a tick box so pressing the
           chosen one again clears it and the action is back to not decided; the script keeps them to
           one at a time and remembers it. The first keeps the attribute the rest of the page finds an
           action by. *@
        <li class="action" data-action-row="@id">
          <svg class="action__mark" aria-hidden="true" focusable="false"><use href="@(Selficient.Web.Pages.Plan.Marks.Sprite)#@Selficient.Web.Pages.Plan.Marks.ForAction(id)"/></svg>
          <span class="action__title" id="action-@id">@action.Title</span>
          <span class="action__why">@action.Why</span>
          <span class="action__cost data">@MoneyFormat.Range(action.Cost)</span>
          <div class="choice" role="group" aria-labelledby="action-@id">
            <label class="choice__pill" data-choice-pill="have">
              <input type="checkbox" class="choice__input" name="tick" value="@id" data-choice="have"
                     data-action-id="@id"
                     data-water="@action.Provides.WaterLitres.ToString(culture)"
                     data-food="@action.Provides.FoodDays.ToString(culture)"
                     data-light="@action.Provides.LightHours.ToString(culture)">
              <span>Have it</span>
            </label>
            <label class="choice__pill" data-choice-pill="plan">
              <input type="checkbox" class="choice__input" name="plan" value="@id" data-choice="plan">
              <span>Plan to</span>
            </label>
            <label class="choice__pill" data-choice-pill="skip">
              <input type="checkbox" class="choice__input" name="skip" value="@id" data-choice="skip">
              <span>Not for me</span>
            </label>
          </div>
          @if (Model.Amounts.TryGetValue(id, out var amount))
          {
            @* The household's own figure for this stock. Out of sight until the action is held or a
               figure has been given, then filled in by the script from what this browser keeps. *@
            <div class="amount" data-amount="@amount.StockId" data-amount-target="@amount.Target" hidden>
              <label for="amount-@id">@Selficient.Web.Pages.Plan.AmountCopy.Question</label>
              <input id="amount-@id" class="input input--short" type="number" inputmode="numeric" min="0" max="@amount.Max" step="1" autocomplete="off" data-amount-input>
              <span class="amount__unit">@amount.Unit</span>
              <span class="amount__hint">@amount.Suggests</span>
            </div>
            <p class="action__progress" data-progress-for="@id" hidden></p>
          }
          @if (picks.Count > 0)
          {
            <details class="picks">
              <summary>Where to look</summary>
              <p class="picks__how">Cheapest first. Each does what the action asks; the dearer ones last longer or do more. A link opens the shop's own search for the item, so it does not go stale, and the price is what we saw on the date given.</p>
              <ul class="picks__list">
                @foreach (var (pick, position) in picks.Select((item, at) => (item, at)))
                {
                  <li class="pick">
                    <a href="@KitLinks.Href(pick)" rel="sponsored noopener noreferrer" target="_blank">@pick.Name</a>
                    @if (position == 0 && picks.Count > 1)
                    {
                      <span class="pick__value">Lowest price that does the job</span>
                    }
                    <span class="pick__meta">@pick.Retailer, <span class="data">@MoneyFormat.Amount(pick.Price)</span>, seen @pick.Seen.ToString("d MMM yyyy", gb)</span>
                    @if (pick.Note.Length > 0)
                    {
                      <span class="pick__note">@pick.Note</span>
                    }
                  </li>
                }
              </ul>
              @await Html.PartialAsync("_TipForm", action.Id.Value)
            </details>
          }
        </li>
      }
    </ul>
  }
</details>
