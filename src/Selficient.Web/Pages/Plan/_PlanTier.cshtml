@using Selficient.Web.Formatting
@model Selficient.Web.Pages.Plan.PlanTierView
@{
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var tier = Model.Tier;
    var index = (int)tier.Tier + 1;
    var gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
}

@* The first two stretches open; the later ones are for later, and fold away so a phone is not a
   thirty-action scroll. Every action stays in the page for the script and for search. *@
<details class="sheet" data-tier="@tier.Tier" open="@(index <= 2)">
  <summary class="sheet__header">
    <span class="sheet__index" aria-hidden="true">@index</span>
    <h3>@tier.Title</h3>
    <span class="data">@MoneyFormat.Range(tier.Cost)</span>
    <span class="sheet__chevron" aria-hidden="true"></span>
  </summary>
  @if (tier.Actions.Count == 0)
  {
    <p class="sheet__empty">Nothing extra for your home in this stretch.</p>
  }
  else
  {
    <progress class="tier-progress" value="0" max="@tier.Actions.Count" data-tier-progress aria-label="Actions done in this stretch">0 of @tier.Actions.Count</progress>
    <ul class="actions">
      @foreach (var action in tier.Actions)
      {
        var picks = Model.Picks[action.Id];
        <li class="action">
          <label>
            <input type="checkbox" name="tick" value="@action.Id.Value"
                   data-action-id="@action.Id.Value"
                   data-water="@action.Provides.WaterLitres.ToString(culture)"
                   data-food="@action.Provides.FoodDays.ToString(culture)"
                   data-light="@action.Provides.LightHours.ToString(culture)">
            <svg class="action__mark" aria-hidden="true" focusable="false"><use href="@(Selficient.Web.Pages.Plan.Marks.Sprite)#@Selficient.Web.Pages.Plan.Marks.ForAction(action.Id.Value)"/></svg>
            <span class="action__title">@action.Title</span>
            <span class="action__why">@action.Why</span>
            <span class="data">@MoneyFormat.Range(action.Cost)</span>
          </label>
          @if (picks.Count > 0)
          {
            <details class="picks">
              <summary>Where to look</summary>
              <p class="picks__how">Cheapest first. Each does what the action asks; the dearer ones last longer or do more. A link opens the shop's own search for the item, so it does not go stale, and the price is what we saw on the date given.</p>
              <ul class="picks__list">
                @foreach (var (pick, position) in picks.Select((item, at) => (item, at)))
                {
                  <li class="pick">
                    <a href="@pick.Link" rel="sponsored noopener noreferrer" target="_blank">@pick.Name</a>
                    @if (position == 0 && picks.Count > 1)
                    {
                      <span class="pick__value">Lowest price that does the job</span>
                    }
                    <span class="pick__meta">@pick.Retailer, <span class="data">@MoneyFormat.Amount(pick.Price)</span>, seen @pick.Seen.ToString("d MMM yyyy", gb)</span>
                    @if (pick.Note.Length > 0)
                    {
                      <span class="pick__note">@pick.Note</span>
                    }
                  </li>
                }
              </ul>
            </details>
          }
        </li>
      }
    </ul>
  }
</details>
