@inject Selficient.Web.Security.CspNonce Nonce
@inject Selficient.Web.Services.ShellVersion Shell
<!DOCTYPE html>
@* data-sw-build is this deploy's shell fingerprint; shell.js compares it with the service
   worker's own version and reloads once on a mismatch, so a device never runs one deploy's
   modules against another deploy's pages. *@
<html lang="en-GB" data-sw-build="@Shell.Current().Version">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#1F5F4A">
  <meta name="application-name" content="Selficient">
  <meta name="apple-mobile-web-app-title" content="Selficient">
  <meta name="mobile-web-app-capable" content="yes">
  <title>@PageTitle.Compose(ViewData["Title"])</title>
  <meta name="description" content="@(ViewData["Description"] ?? "Work out how many days your house could stand on its own, and close the gap with a plan that fits your home.")">
  @await Html.PartialAsync("_SeoHead")
  <link rel="manifest" href="~/manifest.webmanifest">
  <link rel="icon" href="~/img/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">
  @* One sheet per layer, linked rather than imported, so they load side by side. app.css fixes the order and map-chrome.css is unlayered and last. *@
  <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/utilities.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/map-chrome.css" asp-append-version="true">
  <link rel="modulepreload" href="~/js/app.js">
  @* The "!" opts this element out of tag helpers: the framework's ImportMap helper otherwise
     rewrites it and drops the type attribute. The nonce is therefore stamped by hand. *@
  <!script type="importmap" nonce="@Nonce.Value">
    {
      "imports": {
        "selficient/": "/js/",
        "maplibre-gl": "/lib/maplibre/maplibre-gl.mjs"
      }
    }
  </!script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to the main content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="wordmark" href="/" aria-label="Selficient home">
        @* The mark: the contour rings of a hill with the lantern of one house on it. *@
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5"/>
          <circle cx="17" cy="15" r="9.5" fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="1.5"/>
          <circle cx="18" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="18.5" cy="13.5" r="2.2" fill="#E8A127"/>
        </svg>
        <span>Selficient</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/plan">Your plan</a>
        <a href="/plan/solar">Solar</a>
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
          <span class="sr-only">Switch between light and dark</span>
          <span aria-hidden="true">◐</span>
        </button>
      </nav>
    </div>
  </header>
  <p class="offline-banner" data-offline-banner role="status" hidden>You are offline. Your saved plan, its ticks and the map you have already seen still work; building a new plan or an estimate needs a connection.</p>
  <main id="main" class="site-main" tabindex="-1">
    @RenderBody()
  </main>
  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>Selficient helps households prepare for everyday emergencies. It is guidance, not professional advice, and it never replaces the instructions of the emergency services.</p>
      <p>Nothing you enter leaves your browser except the postcode we use to find your area.</p>
      @* Shown by install.js only where the browser can install or explain how, and never inside the
         installed app. It lives below the content so appearing never pushes the page down. *@
      <p class="site-footer__install"><button type="button" class="button button--quiet" data-install hidden>Install the app</button></p>
      <nav class="site-footer__links" aria-label="About this site">
        <a href="/deals">Cheapest kit today</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms and affiliate disclosure</a>
        <a href="/terms#advice">Not professional advice</a>
        <a href="/styleguide">Styleguide</a>
        <a href="mailto:@LegalCopy.ContactEmail">@LegalCopy.ContactEmail</a>
      </nav>
      <p class="site-footer__made">@LegalCopy.MadeBy</p>
    </div>
  </footer>
  <dialog class="dialog" data-install-ios>
    <h2>Put Selficient on this iPhone or iPad</h2>
    <p>Safari does not offer an install button, but it takes two taps.</p>
    <ol>
      <li>Tap <strong>Share</strong>, the square with the arrow, at the bottom of Safari.</li>
      <li>Choose <strong>Add to Home Screen</strong>, then <strong>Add</strong>.</li>
    </ol>
    <p class="field__hint">Selficient then opens from your home screen like any app, and your plan is there without signal.</p>
    <p class="cluster">
      <button type="button" class="button" data-close>Got it</button>
    </p>
  </dialog>
  <script type="module" src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
