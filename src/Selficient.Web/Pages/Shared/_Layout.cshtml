@inject Selficient.Web.Security.CspNonce Nonce
@inject Selficient.Web.Services.ShellVersion Shell
@inject Selficient.Application.Accounts.AccountSignIn Accounts
<!DOCTYPE html>
@* data-sw-build is this deploy's shell fingerprint; shell.js compares it with the service
   worker's own version and reloads once on a mismatch, so a device never runs one deploy's
   modules against another deploy's pages. *@
<html lang="en-GB" data-sw-build="@Shell.Current().Version">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#1F5F4A">
  <meta name="application-name" content="Selficient">
  <meta name="apple-mobile-web-app-title" content="Selficient">
  <meta name="mobile-web-app-capable" content="yes">
  <title>@PageTitle.Compose(ViewData["Title"])</title>
  <meta name="description" content="@(ViewData["Description"] ?? "Work out how many days your house could stand on its own, and close the gap with a plan that fits your home.")">
  @await Html.PartialAsync("_SeoHead")
  <link rel="manifest" href="~/manifest.webmanifest">
  <link rel="icon" href="~/img/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">
  @* One sheet per layer, linked rather than imported, so they load side by side. app.css fixes the order and map-chrome.css is unlayered and last. *@
  <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/utilities.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/map-chrome.css" asp-append-version="true">
  <link rel="modulepreload" href="~/js/app.js">
  @* The "!" opts this element out of tag helpers: the framework's ImportMap helper otherwise
     rewrites it and drops the type attribute. The nonce is therefore stamped by hand. *@
  <!script type="importmap" nonce="@Nonce.Value">
    {
      "imports": {
        "selficient/": "/js/",
        "maplibre-gl": "/lib/maplibre/maplibre-gl.mjs"
      }
    }
  </!script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to the main content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="wordmark" href="/" aria-label="Selficient home">
        @* The mark: the contour rings of a hill with the lantern of one house on it. *@
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5"/>
          <circle cx="17" cy="15" r="9.5" fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="1.5"/>
          <circle cx="18" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="18.5" cy="13.5" r="2.2" fill="#E8A127"/>
        </svg>
        <span>Selficient</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/plan">Your plan</a>
        <a href="/plan/solar">Solar</a>
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
          <span class="sr-only">Switch between light and dark</span>
          <span aria-hidden="true">◐</span>
        </button>
      </nav>
      @* Where "Sign in" is on other sites, this says the thing a visitor is waiting to be told: there is no account to make.
         It is a link to the privacy page until the script runs, and then it opens the panel below. keep.js swaps the words
         once a plan is saved in this browser. The back office is not a household's page and does not carry it. *@
      @if (KeepCopy.ShowsOn(Context.Request.Path))
      {
      <a class="keep-chip" href="/privacy" data-keep-chip data-open-dialog="keep-dialog" data-kept="none">
        <svg class="mark-icon" data-keep-mark="device" aria-hidden="true" focusable="false"><use href="/img/marks.svg#mark-device"/></svg>
        <svg class="mark-icon" data-keep-mark="account" aria-hidden="true" focusable="false" hidden><use href="/img/marks.svg#mark-account"/></svg>
        <span data-keep-label="none">@KeepCopy.ChipNone</span>
        <span data-keep-label="device" hidden>@KeepCopy.ChipDevice</span>
        <span data-keep-label="account" hidden>@KeepCopy.ChipAccount <span class="keep-chip__who" data-keep-email></span></span>
      </a>
      }
    </div>
  </header>
  <p class="offline-banner" data-offline-banner role="status" hidden>You are offline. Your saved plan, its ticks and the map you have already seen still work; building a new plan or an estimate needs a connection.</p>
  <main id="main" class="site-main" tabindex="-1">
    @RenderBody()
  </main>
  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>Selficient helps households prepare for everyday emergencies. It is guidance, not professional advice, and it never replaces the instructions of the emergency services.</p>
      <p>Your plan is kept in your own browser. What leaves it, and when, is on the <a href="/privacy">privacy page</a>.</p>
      @* Shown by install.js only where the browser can install or explain how, and never inside the
         installed app. It lives below the content so appearing never pushes the page down. *@
      <p class="site-footer__install"><button type="button" class="button button--quiet" data-install hidden>Install the app</button></p>
      <nav class="site-footer__links" aria-label="About this site">
        <a href="/deals">Cheapest kit today</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms and affiliate disclosure</a>
        <a href="/terms#advice">Not professional advice</a>
        <a href="/styleguide">Styleguide</a>
        <a href="mailto:@LegalCopy.ContactEmail">@LegalCopy.ContactEmail</a>
      </nav>
      <p class="site-footer__made">@LegalCopy.MadeBy</p>
    </div>
  </footer>
  <dialog class="dialog keep" id="keep-dialog" data-keep-dialog aria-labelledby="keep-heading">
    <h2 id="keep-heading">@KeepCopy.PanelHeading</h2>
    @* keep.js marks the row the plan is kept in now: this one for a guest with a plan, the account's for a household signed in. *@
    <section class="keep__row" aria-labelledby="keep-device" data-keep-row="device">
      <h3 id="keep-device"><svg class="mark-icon" aria-hidden="true" focusable="false"><use href="/img/marks.svg#mark-device"/></svg>@KeepCopy.DeviceHeading<span class="keep__here" data-keep-here hidden>@KeepCopy.KeptHere</span></h3>
      <p data-keep-says="device-none">@KeepCopy.DeviceNone</p>
      <p data-keep-says="device" hidden>@KeepCopy.DeviceKept</p>
      <p data-keep-says="account" hidden>@KeepCopy.DeviceSignedIn</p>
      <p data-keep-says="account-none" hidden>@KeepCopy.DeviceSignedInNone</p>
      <p class="keep__warning" data-keep-safari hidden>@KeepCopy.Safari(Accounts.IsAvailable)</p>
    </section>
    @* Only once there is a plan to send. A copy is a copy: the sentence says so before the button and again when it has gone. *@
    <section class="keep__row" aria-labelledby="keep-another" data-keep-another hidden>
      <h3 id="keep-another"><svg class="mark-icon" aria-hidden="true" focusable="false"><use href="/img/marks.svg#mark-devices"/></svg>@KeepCopy.AnotherHeading</h3>
      <div class="keep__part" data-send-state="idle">
        <p>@KeepCopy.AnotherSentence</p>
        <p class="cluster"><button type="button" class="button" data-send-copy>@KeepCopy.SendButton</button></p>
      </div>
      <div class="keep__part" data-send-state="code" hidden>
        <div class="keep__code" data-send-code role="img" aria-label="@KeepCopy.SendCodeLabel"></div>
        <p>@KeepCopy.SendScan</p>
        <p class="cluster"><button type="button" class="button button--quiet" data-send-link>@KeepCopy.SendLink</button></p>
      </div>
      <div class="keep__part" data-send-state="sent" hidden>
        <p>@KeepCopy.Sent@if (Accounts.IsAvailable) {<span data-keep-guest> @KeepCopy.SentAccount</span>}</p>
        <p class="cluster"><button type="button" class="button button--quiet" data-send-copy>@KeepCopy.SendButton again</button></p>
      </div>
      <div role="status">
        @foreach (var (key, sentence) in KeepCopy.SendSays)
        {
          <p class="keep__says" data-send-says="@key" hidden>@sentence</p>
        }
      </div>
    </section>
    @* Only where this server can send a sign-in code. An account is offered as the third way to keep a plan, never as a step. *@
    @if (Accounts.IsAvailable)
    {
    <section class="keep__row" aria-labelledby="keep-account" data-keep-account data-keep-row="account">
      <h3 id="keep-account"><svg class="mark-icon" aria-hidden="true" focusable="false"><use href="/img/marks.svg#mark-account"/></svg><span data-keep-guest>@KeepCopy.AccountHeading</span><span data-keep-member hidden>@KeepCopy.YourAccountHeading</span><span class="keep__here" data-keep-here hidden>@KeepCopy.KeptHere</span></h3>
      <div class="keep__part" data-keep-guest>
        <p>@KeepCopy.AccountSentence</p>
        <p class="cluster"><a class="button" href="/account/sign-in">@KeepCopy.CreateAccount</a></p>
      </div>
      <div class="keep__part" data-keep-member hidden>
        <p>@KeepCopy.SignedInAs <strong class="keep__who" data-keep-email></strong>.</p>
        @* sync.js shows one of these: in step, waiting for a connection, or two plans to choose between. *@
        <p data-sync-status="synced">@SyncCopy.Synced</p>
        <p data-sync-status="waiting" hidden>@SyncCopy.Waiting</p>
        <p data-sync-status="choosing" hidden>@SyncCopy.Choosing <button type="button" class="button button--quiet" data-sync-choose>@SyncCopy.Choose</button></p>
        <p class="cluster"><a class="button button--quiet" href="/account/sign-out">@KeepCopy.SignOut</a> <a class="button button--quiet" href="/account/delete">@KeepCopy.DeleteAccount</a></p>
      </div>
    </section>
    <p class="keep__already" data-keep-guest>@KeepCopy.AlreadyHave <a href="/account/sign-in">@KeepCopy.SignIn</a>.</p>
    }
    <p class="cluster">
      <button type="button" class="button" data-close>Close</button>
    </p>
  </dialog>
  @if (Accounts.IsAvailable)
  {
  @* Sync is quiet: it speaks here only when a plan has moved or another device's details replaced the ones on this one. *@
  <div class="sync-notice" data-sync-notice role="status" hidden>
    @foreach (var (key, sentence) in SyncCopy.Says)
    {
      <p data-sync-says="@key" hidden>@sentence</p>
    }
    <button type="button" class="button button--quiet" data-sync-dismiss>Got it</button>
  </div>
  @* The first time a device's own plan meets a different plan in the account, the person chooses. Never a merge of the two. *@
  <dialog class="dialog keep" data-sync-choice aria-labelledby="sync-choice-heading">
    <h2 id="sync-choice-heading">@SyncCopy.ChoiceHeading</h2>
    <p class="receive__summary" data-sync-theirs></p>
    <p class="receive__summary" data-sync-mine></p>
    <p>@SyncCopy.ChoiceSentence</p>
    <p class="cluster">
      <button type="button" class="button button--primary" data-sync-take="account">@SyncCopy.TakeAccount</button>
      <button type="button" class="button" data-sync-take="device">@SyncCopy.TakeDevice</button>
    </p>
  </dialog>
  }
  <dialog class="dialog" data-install-ios>
    <h2>Put Selficient on this iPhone or iPad</h2>
    <p>Safari does not offer an install button, but it takes two taps.</p>
    <ol>
      <li>Tap <strong>Share</strong>, the square with the arrow, at the bottom of Safari.</li>
      <li>Choose <strong>Add to Home Screen</strong>, then <strong>Add</strong>.</li>
    </ol>
    <p class="field__hint">Selficient then opens from your home screen like any app, and your plan is there without signal.</p>
    <p class="cluster">
      <button type="button" class="button" data-close>Got it</button>
    </p>
  </dialog>
  <script type="module" src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
