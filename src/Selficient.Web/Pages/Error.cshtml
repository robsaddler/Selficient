@page "/error/{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="notice" aria-labelledby="error-heading">
  <p class="eyebrow">@Model.Status</p>
  <h1 id="error-heading">@Model.Title</h1>
  <p>@Model.Message</p>
  <p><a class="button" href="/">Go back to your plan</a></p>
</section>
