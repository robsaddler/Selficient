@model Selficient.Web.Pages.Admin.CatalogueModel.OfferRow
@* The one hand a row offers: show what is hidden or proposed, hide what is shown. The choice is the row's, not the view's. *@
<form method="post" asp-page-handler="@Model.Hand" asp-route-id="@Model.Offer.Id"><button type="submit" class="button button--quiet">@Model.Hand</button></form>
