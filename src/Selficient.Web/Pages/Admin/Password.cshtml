@page "/admin/password"
@model Selficient.Web.Pages.Admin.PasswordModel
@{
    ViewData["Title"] = "Change your password";
    ViewData["NoIndex"] = true;
}

<section class="panel-page" aria-labelledby="password-heading">
  <form method="post" class="panel" novalidate>
    <p class="eyebrow">The reviewer</p>
    <h1 id="password-heading">Change your password</h1>
    @if (Model.Forced)
    {
      <p class="panel__lede">This account was created with a starting password, so it has to be replaced before you can review anything. Choose something only you know.</p>
    }
    else
    {
      <p class="panel__lede">Changing your password signs out every other device at once.</p>
    }
    @if (Model.Refusal is { } refusal)
    {
      <p class="callout callout--warning" role="alert">@refusal</p>
    }
    <div class="field">
      <label asp-for="Current">Your password now</label>
      <input asp-for="Current" type="password" class="input" autocomplete="current-password" required>
    </div>
    <div class="field">
      <label asp-for="Fresh">Your new password</label>
      <input asp-for="Fresh" type="password" class="input" autocomplete="new-password" required>
      <p class="field__help">At least @Selficient.Application.Security.PasswordPolicy.MinimumLength characters. A short sentence you can remember is stronger than a short word with symbols in it.</p>
    </div>
    <div class="field">
      <label asp-for="Again">Your new password again</label>
      <input asp-for="Again" type="password" class="input" autocomplete="new-password" required>
    </div>
    <div class="panel__actions">
      <button type="submit" class="button button--primary">Change my password</button>
    </div>
  </form>
</section>
