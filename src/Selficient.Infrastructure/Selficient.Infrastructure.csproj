<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters for the Application ports: HTTP clients, caching, catalogue, image processing. -->
  <PropertyGroup>
    <RootNamespace>Selficient.Infrastructure</RootNamespace>
    <!-- Options binding and HttpClient factories are reflection-based; this assembly is never trimmed. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Selficient.Application/Selficient.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Kit/kit-catalogue.json" LogicalName="Selficient.Infrastructure.Kit.kit-catalogue.json" />
    <EmbeddedResource Include="Data/Migrations/*.sql" LogicalName="Selficient.Infrastructure.Data.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Fido2" />
  </ItemGroup>

</Project>
