<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters for the Application ports: HTTP clients, caching, catalogue, image processing. -->
  <PropertyGroup>
    <RootNamespace>Selficient.Infrastructure</RootNamespace>
    <!-- Options binding and HttpClient factories are reflection-based; this assembly is never trimmed. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Selficient.Application/Selficient.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Kit/kit-catalogue.json" LogicalName="Selficient.Infrastructure.Kit.kit-catalogue.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
