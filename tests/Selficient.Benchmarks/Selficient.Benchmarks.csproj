<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BenchmarkDotNet for the rules engine. Not a test project and not in the coverage gate; run by hand
    (see docs/benchmarks.md for the command) and record the numbers there when the engine changes.
    Threat model case 9.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1515;CA1822;CA1062</NoWarn>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Selficient.Application/Selficient.Application.csproj" />
    <ProjectReference Include="../Selficient.TestKit/Selficient.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
