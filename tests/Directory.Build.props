<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      xunit v3 runs on the Microsoft Testing Platform rather than VSTest, which the .NET 10 SDK no
      longer supports. This opts `dotnet test` into driving it.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!--
      Documentation comments are a production concern. Requiring them on every test would bury the
      one thing a test should communicate, the behaviour it pins down, under ceremony.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Tests deliberately construct invalid arguments, pass nulls into non-nullable parameters and
      name methods in prose. These rules would otherwise make the adversarial suites unwritable.
    -->
    <NoWarn>$(NoWarn);CA1861;CA2007;CS8625;CA1707;CA1515;IDE0058;CA1305;CA1859;CA1711;CA1806;CA2201;CA1062;CA2234;xUnit1051</NoWarn>

    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
