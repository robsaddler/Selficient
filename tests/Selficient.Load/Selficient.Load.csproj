<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NBomber load runs against the application hosted on Kestrel in this process, on the fakes, with
    the rate limits lifted. Not a test project and not in the coverage gate; run with
    build/run-load.ps1 and record the numbers in docs/benchmarks.md when they change.
  -->
  <PropertyGroup>
    <!-- The web SDK turns these on for the site; the harness hosts the site in-process, so it must match or it measures a console app's collector under a web server's allocation. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1515;CA1822;CA1062;CA2007;CA1303;CA1848</NoWarn>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Selficient.Web/Selficient.Web.csproj" />
    <ProjectReference Include="../Selficient.TestKit/Selficient.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="NBomber" />
    <PackageReference Include="NBomber.Http" />
  </ItemGroup>

</Project>
